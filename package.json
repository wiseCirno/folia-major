{
  "name": "folia-major",
  "productName": "Folia",
  "description": "Lyrics Reimagine",
  "author": {
    "name": "chthollyphile",
    "email": "chthollyphile@users.noreply.github.com"
  },
  "private": true,
  "version": "0.7.28",
  "license": "AGPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:probe": "vite --open /dev-probe.html",
    "build": "npm run build:vercel-api && vite build",
    "build:vercel-api": "tsc -p api-ts/tsconfig.json",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "codemap": "node dev/mcp/ts-code-map/codemap.mjs",
    "folium:api": "node dev/folium/api-docs.mjs",
    "folium:types": "node dev/folium/types.mjs",
    "folium:new": "node dev/folium/new.mjs",
    "folium:check": "node dev/folium/check.mjs",
    "codemap:check": "node dev/mcp/ts-code-map/codemap.mjs --check",
    "dedicatus": "node dev/dedicatus/cli.mjs",
    "lint": "node dev/dedicatus/cli.mjs --lint",
    "lint:install": "npm ci --prefix dev/dedicatus/lint --no-audit --no-fund",
    "lint:fix": "node dev/dedicatus/eslint/eslint.mjs --fix",
    "lint:fix-style": "node dev/dedicatus/eslint/fixStyle.mjs",
    "lint:prune": "node dev/dedicatus/eslint/prune.mjs",
    "coven:scope": "node packages/coven/bin/coven.mjs scope",
    "coven:state": "node packages/coven/bin/coven.mjs state",
    "coven:claim": "node packages/coven/bin/coven.mjs claim",
    "coven:prompt": "node packages/coven/bin/coven.mjs prompt",
    "coven:contract": "node packages/coven/bin/coven.mjs contract",
    "coven:verify": "node packages/coven/bin/coven.mjs verify",
    "coven:pr": "node packages/coven/bin/coven.mjs pr",
    "coven:setup": "node packages/coven/bin/coven.mjs setup",
    "coven:compass": "node packages/coven/bin/coven.mjs compass",
    "test": "vitest run -c vitest.config.ts",
    "test:unit": "vitest run -c vitest.config.ts",
    "test:unit:watch": "vitest -c vitest.config.ts",
    "test:ui": "playwright test",
    "test:component": "playwright test --project=components",
    "test:ui:update": "playwright test --update-snapshots",
    "test:render": "playwright test -c playwright.probe.config.ts",
    "benchmark:lyrics": "npx tsx test/manual/lyrics_benchmark.ts",
    "manual:analysis-idle": "node test/manual/analysis_idle_release.mts",
    "manual:visualizer-memory": "node test/manual/visualizer-memory-probe.mjs",
    "manual:lattice-cover-memory": "node test/manual/lattice-cover-memory.mjs",
    "manual:bravais-perf": "node test/manual/bravais-perf-probe.mjs",
    "stage:client": "vite --open /stage-client.html",
    "contributors:add": "npx all-contributors-cli add",
    "contributors:generate": "npx all-contributors-cli generate",
    "models:fetch": "node build/fetchModels.mjs",
    "steam-audio:fetch": "node build/fetchSteamAudio.mjs",
    "manual:ai-probe": "node test/manual/ai_probe.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "axios": "^1.20.0",
    "bgutils-js": "4.0.3",
    "busboy": "^1.6.0",
    "fflate": "^0.8.3",
    "file-type": "^21.3.4",
    "googlevideo": "4.1.1",
    "koffi": "^3.3.1",
    "music-metadata": "^11.16.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@applemusic-like-lyrics/ttml": "^1.0.1",
    "@chenglou/pretext": "^0.0.9",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@paper-design/shaders-react": "^0.0.80",
    "@playwright/test": "^1.63.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/blueimp-md5": "^2.18.2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@webgpu/types": "0.1.74",
    "@xmldom/xmldom": "^0.9.12",
    "animejs": "^4.5.0",
    "autoprefixer": "^10.6.1",
    "baseline-browser-mapping": "^2.11.26",
    "blueimp-md5": "^2.19.0",
    "budoux": "^0.9.3",
    "buffer": "^6.0.3",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "dexie": "^4.4.6",
    "fake-indexeddb": "^6.2.5",
    "framer-motion": "^13.4.3",
    "i18next": "^26.4.2",
    "lucide-react": "^1.48.0",
    "opencc-js": "^1.4.2",
    "pinyin-pro": "3.29.3",
    "pixi.js": "^8.21.0",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-window": "^2.3.3",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "twgl.js": "^7.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0",
    "wanakana": "^5.3.1",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "@babel/plugin-transform-runtime": "7.29.7",
    "concurrently": {
      "shell-quote": "1.12.0"
    },
    "@discordjs/rest": {
      "undici": "^6.27.0"
    },
    "qs": "6.16.0",
    "three-stdlib": {
      "fflate": "$fflate"
    }
  },
  "optionalDependencies": {
    "@lox-audioserver/node-librespot": "0.5.1"
  },
  "coven": {
    "config": "dev/coven/config.json"
  }
}
